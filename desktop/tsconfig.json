{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "allowImportingTsExtensions": true
  },
  "include": ["main", "preload", "renderer", "../src/sidepane/attention.ts"],
  "exclude": ["node_modules", "dist"]
}
